# WZRD environment — copy to .env (loaded automatically by `python -m wzrd_mcp`).
#
# A local session needs two keys: GEMINI_API_KEY (images) and FAL_KEY (video).
# Everything else is optional.

# --- Remote model calls ----------------------------------------------------
# Google Gemini API key — required by nano_banana (Nano Banana 2.1, called
# directly; reference images go inline in the request).
GEMINI_API_KEY=
# Fallback, used only when GEMINI_API_KEY is unset: a Vertex AI API key and
# its Google Cloud project (defaults to gen-lang-client-0837456283).
# VERTEX_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# FAL API key — required by the kling_* tools. Results download into the
# active project folder; local inputs are uploaded to FAL's own CDN just in time.
FAL_KEY=

# --- Where output lands ----------------------------------------------------
# Default project for a session (the `set_project` tool overrides it at runtime).
# WZRD_PROJECT=default
# Root holding all project folders. Defaults to <repo>/projects (gitignored).
# WZRD_PROJECTS_ROOT=

# --- Remote deployment (parked) --------------------------------------------
# Bearer token for a remote MCP deployment. Not needed locally.
# WZRD_API_KEY=
# Modal secret name used by modal_app.py (was Eden's "eve-secrets-PROD").
# WZRD_MODAL_SECRET=wzrd-secrets

# --- Dormant S3 publish path (file_io.upload) ------------------------------
# Nothing calls this today. Set these only when reviving it against a bucket
# you own; needs the `s3` extra (boto3).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION_NAME=us-east-1
# CLOUDFRONT_URL=

# --- TextureFlow (disabled — still Eden-hosted) ----------------------------
# See docs/TODO/eden-decoupling.md before re-enabling.
# MODAL_APP_NAME=
# MODAL_CLS_NAME=
