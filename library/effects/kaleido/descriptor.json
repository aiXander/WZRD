{
  "name": "kaleido",
  "description": "Mirrored-wedge kaleidoscope around the clip centre; twist bends it into a spiral.",
  "audio": "zoom (audio.band low, range ~[1.0, 1.6]) or twist",
  "inputs": [
    { "name": "image", "type": "image" },
    { "name": "segments", "type": "float", "default": 6, "min": 2, "max": 16, "step": 1 },
    { "name": "spin", "type": "float", "default": 0.125, "min": -1, "max": 1, "step": 0.005, "unit": "turns/bar" },
    { "name": "zoom", "type": "float", "default": 1.0, "min": 0.25, "max": 4, "step": 0.01 },
    { "name": "twist", "type": "float", "default": 0.0, "min": -6, "max": 6, "step": 0.05 },
    { "name": "gain", "type": "float", "default": 1.0, "min": 0, "max": 2, "step": 0.01 }
  ]
}
