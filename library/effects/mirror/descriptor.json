{
  "name": "mirror",
  "description": "Mirror fold (left-right, top-bottom, quad) or flip of the clip inside its box; the axis sways slowly.",
  "audio": "sway (audio.band mid, range ~[0, 0.2])",
  "inputs": [
    { "name": "image", "type": "image" },
    { "name": "mode", "type": "float", "default": 2, "min": 0, "max": 4, "step": 1 },
    { "name": "axis", "type": "float", "default": 0.5, "min": 0.1, "max": 0.9, "step": 0.01 },
    { "name": "sway", "type": "float", "default": 0.06, "min": 0, "max": 0.3, "step": 0.005 },
    { "name": "gain", "type": "float", "default": 1.0, "min": 0, "max": 2, "step": 0.01 }
  ]
}
