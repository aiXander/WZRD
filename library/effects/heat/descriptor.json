{
  "name": "heat",
  "description": "Thermal-camera false colour from the clip's brightness (black, indigo, magenta, orange, yellow, white); offset/cycle scroll the palette.",
  "audio": "offset (audio.band low, range ~[0, 0.4])",
  "inputs": [
    { "name": "image", "type": "image" },
    { "name": "contrast", "type": "float", "default": 1.3, "min": 0.25, "max": 4, "step": 0.01 },
    { "name": "offset", "type": "float", "default": 0.0, "min": -1, "max": 1, "step": 0.01 },
    { "name": "cycle", "type": "float", "default": 0.0, "min": -1, "max": 1, "step": 0.005, "unit": "per bar" },
    { "name": "amount", "type": "float", "default": 1.0, "min": 0, "max": 1, "step": 0.01 },
    { "name": "gain", "type": "float", "default": 1.0, "min": 0, "max": 2, "step": 0.01 }
  ]
}
