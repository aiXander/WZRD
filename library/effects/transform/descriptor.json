{
  "name": "transform",
  "description": "Zoom, rotate, spin and pan the clip inside its box; tile mirror-repeats past the edges.",
  "audio": "zoom (audio.onset low, range ~[1.0, 1.25] — a kick punch-in)",
  "inputs": [
    { "name": "image", "type": "image" },
    { "name": "zoom", "type": "float", "default": 1.0, "min": 0.25, "max": 4, "step": 0.01 },
    { "name": "rotate", "type": "float", "default": 0.0, "min": -0.5, "max": 0.5, "step": 0.005, "unit": "turns" },
    { "name": "spin", "type": "float", "default": 0.0, "min": -1, "max": 1, "step": 0.005, "unit": "turns/bar" },
    { "name": "pan_x", "type": "float", "default": 0.0, "min": -1, "max": 1, "step": 0.005 },
    { "name": "pan_y", "type": "float", "default": 0.0, "min": -1, "max": 1, "step": 0.005 },
    { "name": "tile", "type": "float", "default": 1, "min": 0, "max": 1, "step": 1 },
    { "name": "gain", "type": "float", "default": 1.0, "min": 0, "max": 2, "step": 0.01 }
  ]
}
