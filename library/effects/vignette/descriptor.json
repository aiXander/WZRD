{
  "name": "vignette",
  "description": "Fades the clip out toward its box edges (rectangular to elliptical); softens hard region edges.",
  "audio": "radius (audio.band low, range ~[0.6, 1.3])",
  "inputs": [
    { "name": "image", "type": "image" },
    { "name": "radius", "type": "float", "default": 1.0, "min": 0.1, "max": 1.6, "step": 0.01 },
    { "name": "soft", "type": "float", "default": 0.5, "min": 0.01, "max": 1.5, "step": 0.01 },
    { "name": "roundness", "type": "float", "default": 1.0, "min": 0, "max": 1, "step": 0.01 },
    { "name": "gain", "type": "float", "default": 1.0, "min": 0, "max": 2, "step": 0.01 }
  ]
}
