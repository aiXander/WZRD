{
  "name": "rgbSplit",
  "description": "Red/blue channel offset along a slowly spinning direction (chromatic split).",
  "audio": "amount (audio.onset low, range ~[0.004, 0.03])",
  "inputs": [
    { "name": "image", "type": "image" },
    { "name": "amount", "type": "float", "default": 0.008, "min": 0, "max": 0.06, "step": 0.001 },
    { "name": "angle", "type": "float", "default": 0.0, "min": 0, "max": 1, "step": 0.01, "unit": "turns" },
    { "name": "spin", "type": "float", "default": 0.25, "min": -2, "max": 2, "step": 0.01, "unit": "turns/bar" },
    { "name": "gain", "type": "float", "default": 1.0, "min": 0, "max": 2, "step": 0.01 }
  ]
}
